{
  "name": "pep-hospitalar-aghuse",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema Web de Prontuário Eletrônico do Paciente (PEP) Hospitalar inspirado na organização funcional do AGHUse",
  "scripts": {
    "dev": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/next/dist/bin/next dev -p 3000",
    "build": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/prisma/build/index.js generate && node ./node_modules/next/dist/bin/next build",
    "start": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/next/dist/bin/next start -p 3000",
    "db:generate": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/prisma/build/index.js generate",
    "db:push": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/prisma/build/index.js db push",
    "db:migrate": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/prisma/build/index.js migrate dev",
    "db:seed": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed",
    "test": "(dot_clean -m . 2>/dev/null || true) && node ./node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.29",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.2",
    "prisma": "6.4.1",
    "tailwindcss": "^4.0.6",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.5"
  }
}
